# Copy this file to .env and fill in your own values. Never commit the real .env file.
OPENAI_API_KEY=your-azure-openai-api-key
API_VERSION=your-azure-api-version
OPENAI_API_BASE=https://your-azure-endpoint.openai.azure.com/
OPENAI_ORGANIZATION=
# Azure deployment name to call. Run the pipeline once per model:
#   MODEL=your-gpt-4o-deployment-name
#   MODEL=your-gpt-5-deployment-name
MODEL=your-deployment-name
